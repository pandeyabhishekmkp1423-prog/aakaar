# ----------------------------------------------------------------------
# Techvorainc.ca - Hostinger Production Configuration
# Upload this as .env to /public_html/admin/ (or your subdomain directory)
# ----------------------------------------------------------------------

APP_NAME="Techvorainc.ca Management API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.techvorainc.ca
ADMIN_URL=https://admin.techvorainc.ca
FRONTEND_URL=https://techvorainc.ca

# ----------------------------------------------------------------------
# Hostinger MySQL Database Settings
# ----------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u948388602_techvora
DB_USERNAME=u948388602_admin
DB_PASSWORD=lGuCw4y4:
DB_CHARSET=utf8mb4

# ----------------------------------------------------------------------
# CORS & Security
# ----------------------------------------------------------------------
ALLOWED_ORIGINS="https://techvorainc.ca,https://www.techvorainc.ca,https://admin.techvorainc.ca"

# ----------------------------------------------------------------------
# Session Sharing across Subdomain and Main Domain
# ----------------------------------------------------------------------
SESSION_COOKIE_NAME=techvora_admin_session
SESSION_LIFETIME=604800
SESSION_SECURE=true
SESSION_SAMESITE=None
SESSION_DOMAIN=.techvorainc.ca

# ----------------------------------------------------------------------
# Rate Limiting & Bot Protection
# ----------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
ENQUIRY_MIN_TIME_SEC=3

# ----------------------------------------------------------------------
# Email Lead Notifications
# ----------------------------------------------------------------------
MAIL_ENABLED=true
ADMIN_EMAIL=info@techvorainc.ca
MAIL_FROM_ADDRESS=noreply@techvorainc.ca
MAIL_FROM_NAME="Techvorainc.ca Leads"
