# ----------------------------------------------------------------------
# Techvorainc.ca - Admin & Backend Root .htaccess
# ----------------------------------------------------------------------

DirectoryIndex index.php index.html public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header in PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Direct API requests to index.php
    RewriteRule ^v1/(.*)$ index.php [L,QSA]
    RewriteRule ^admin/v1/(.*)$ index.php [L,QSA]

    # 2. Direct upload requests to index.php
    RewriteRule ^uploads/(.*)$ index.php [L,QSA]
    RewriteRule ^admin/uploads/(.*)$ index.php [L,QSA]

    # 2b. Direct admin assets requests
    RewriteRule ^admin/assets/(.*)$ assets/$1 [L]

    # 3. Serve existing files/folders directly (assets, index.html, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Front Controller Routing for all other endpoints
    RewriteRule ^ index.php [L]
</IfModule>

# Protect sensitive environment and data files (Apache 2.4 & 2.2 safe)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.|\.(sqlite|log|ini|sh|bak|env|sql)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|\.(sqlite|log|ini|sh|bak|env|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
