# -------------------------------------------------------------
# Techvorainc.ca Backend Environment Configuration
# -------------------------------------------------------------

APP_NAME="Techvorainc.ca API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
ADMIN_URL=https://admin.techvorainc.ca
FRONTEND_URL=https://techvorainc.ca

# Database Settings
# Set DB_DRIVER=sqlite for zero-config SQLite, or DB_DRIVER=mysql for MySQL/MariaDB
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/data/database.sqlite

# MySQL / MariaDB Settings (Used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_techvora
DB_USERNAME=u123456789_admin
DB_PASSWORD=YourStrongDatabasePassword123!
DB_CHARSET=utf8mb4

# CORS Settings (Comma-separated allowed domains)
ALLOWED_ORIGINS="https://techvorainc.ca,https://www.techvorainc.ca,https://admin.techvorainc.ca,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Session Settings
SESSION_COOKIE_NAME=techvora_admin_session
SESSION_LIFETIME=604800
SESSION_SECURE=false
SESSION_SAMESITE=Lax
# For sharing session across *.techvorainc.ca, set:
# SESSION_DOMAIN=.techvorainc.ca

# Rate Limiting & Security
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
ENQUIRY_MIN_TIME_SEC=3

# Email Lead Notifications
MAIL_ENABLED=false
ADMIN_EMAIL=info@techvorainc.ca
MAIL_FROM_ADDRESS=noreply@techvorainc.ca
MAIL_FROM_NAME="Techvorainc.ca Leads"
